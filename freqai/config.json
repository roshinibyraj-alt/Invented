{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "invented-freqai-predictor",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "initial_state": "running",
  "trading_mode": "spot",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 10,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "timeframe": "1m",
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "urls": {
        "api": {
          "public": "https://data-api.binance.vision/api/v3"
        }
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "freqai": {
    "enabled": true,
    "identifier": "invented-btc-5m-window-direction-v1",
    "purge_old_models": 2,
    "train_period_days": 14,
    "backtest_period_days": 1,
    "live_retrain_hours": 1,
    "feature_parameters": {
      "include_timeframes": [
        "1m"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 5,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [],
      "DI_threshold": 0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42
    },
    "model_training_parameters": {
      "n_estimators": 120,
      "learning_rate": 0.04,
      "num_leaves": 15,
      "max_depth": 4,
      "class_weight": "balanced",
      "verbosity": -1,
      "n_jobs": 2
    }
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
