# Copy to .env for local runs. On Railway, set these as Variables instead.

# --- Window ---
WINDOW_SECONDS=300
WINDOW_LABEL=5m

# --- Capital / sizing ---
STARTING_CAPITAL_PER_ENGINE=1000
ENTRY_DOLLARS=100

# --- Take-profit / stop-loss (token price; entry is near $0.50) ---
TAKE_PROFIT_PRICE=0.70
STOP_LOSS_PRICE=0.30

# --- Execution (taker-only, always crosses the spread) ---
BUY_SLIPPAGE_CEILING=0.99
SELL_SLIPPAGE_FLOOR=0.01

# --- Fees (fallback only; live rate is read per-market from Gamma) ---
FALLBACK_TAKER_FEE_RATE=0.07

# --- Resolution (time-decay / hold-to-close path) ---
# Primary: Polymarket's own official resolution via Gamma (closed +
# outcomePrices) -- the real oracle-based settlement. If Gamma hasn't
# confirmed within GAMMA_RESOLUTION_TIMEOUT_SECONDS of window close, falls
# back to the CLOB's actual last-traded price (never bid/ask/midpoint).
GAMMA_RESOLUTION_CONFIDENCE=0.99
GAMMA_RESOLUTION_TIMEOUT_SECONDS=90
CLOB_FALLBACK_PRICE_THRESHOLD=0.97

# --- Polling ---
POLL_INTERVAL_SECONDS=1.5
RESOLUTION_POLL_SECONDS=2
RESOLUTION_POLL_TIMEOUT_SECONDS=180

# --- Storage ---
# If you attach a Railway Volume, mount it at /data and this is picked up
# automatically. Otherwise it falls back to a local file (lost on redeploy).
DB_PATH=/data/pool_bot_state.db

# --- Web ---
PORT=8080
