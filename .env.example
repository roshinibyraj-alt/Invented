# All optional. Defaults shown.

# Paper trading only for now.
# TRADING_MODE=paper
# STARTING_CAPITAL=2000

# Entry: resting limit first, taker fallback after the timeout.
# LIMIT_PRICE=0.40
# LIMIT_SHARES=200
# LIMIT_TIMEOUT_SECONDS=120
# TAKER_SHARES=300
# TAKER_MAX_PRICE=0.60

# Binance klines endpoint for the previous window's 1-minute closes (no API key).
# Override if your host is geo-blocked, e.g. https://api.binance.us/api/v3/klines
# BINANCE_KLINES_URL=https://api.binance.com/api/v3/klines
# BINANCE_SYMBOL=BTCUSDT

# POLL_INTERVAL_SECONDS=1.0
