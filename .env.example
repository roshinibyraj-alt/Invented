# All variables below are optional -- every one has a working default
# in app/config.py. Copy this file to .env and uncomment/edit only
# what you want to change.

# paper | live (only "paper" is implemented in this codebase)
# TRADING_MODE=paper

# Polymarket API bases -- only override for a custom gateway/mirror
# GAMMA_API_BASE=https://gamma-api.polymarket.com
# CLOB_API_BASE=https://clob.polymarket.com

# How often the main loop polls Polymarket's CLOB for prices (seconds)
# POLL_INTERVAL_SECONDS=1.0

# Starting paper-trading balance (single shared pool across all trades)
# STARTING_CAPITAL=2000

# Seconds after a window opens before the taker buy fires, and the max
# best-ask at which it will buy (1.0 = no cap).
# ENTRY_DELAY_SECONDS=2.0
# ENTRY_MAX_PRICE=0.60

# Days of Binance history for the startup pre-backtest, and the length
# of the rolling window the multi-timeframe engine keeps re-mining.
# 15-minute windows give ~96 per day, so 7 days is only ~670 samples; 14-21 finds real patterns more reliably.
# MTF_BACKTEST_DAYS=7

# 1 (default): every window gets a call -- noise-validated situations first,
# then weak patterns, then a baseline over all readings (tier shown with each
# call). 0: trade ONLY when a noise-validated situation matches.
# MTF_ALLOW_FALLBACK=1

# A "situation" must match at least this many backtest windows, and its
# hit rate must beat a coin flip by at least this z-score (2.6 ~ p<0.01).
# MTF_MIN_SAMPLES=25
# MTF_MIN_Z=2.6

# Binance klines endpoint (analysis data only, no API key). Override if
# your host is geo-blocked, e.g. https://api.binance.us/api/v3/klines
# BINANCE_KLINES_URL=https://api.binance.com/api/v3/klines
# BINANCE_SYMBOL=BTCUSDT
