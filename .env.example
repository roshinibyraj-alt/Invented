# All optional. Defaults shown.

# Paper trading only for now.
# TRADING_MODE=paper
# STARTING_CAPITAL=2000

# Entry: one taker market buy, fired this many seconds after the window opens, at any price.
# ENTRY_DELAY_SECONDS=5

# Size ladder (one shared base, both sides).
# BASE_SHARES=500
# SHARES_STEP=100

# A side is the window's winner once its CLOB price reaches this in the last second.
# WIN_PRICE=0.95

# POLL_INTERVAL_SECONDS=1.0
# CLOSE_PHASE_POLL_SECONDS=0.25
