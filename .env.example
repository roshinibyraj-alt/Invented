# Copy to .env for local runs. Railway: set these under Variables instead.

TRADING_MODE=paper
STARTING_BALANCE_USDC=5000
POLL_INTERVAL_SECONDS=1.0

# Only needed if Polymarket's public endpoints change / require a key
# in your region. Leave as-is otherwise.
GAMMA_API_BASE=https://gamma-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com
